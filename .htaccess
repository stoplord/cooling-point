# ==========================================================================
# M/S. Cooling Point: Apache configuration (cPanel / shared hosting)
# Compression, browser caching, security headers and a custom 404 page.
# Nginx users: see README.md > Deployment.
# ==========================================================================

Options -Indexes
ErrorDocument 404 /404.html

# Do not expose build/source tooling
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^(node_modules|tools|integrations)(/|$) - [F,L]
  RewriteRule ^(package(-lock)?\.json|README\.md|\.git.*)$ - [F,L]
</IfModule>

# ---------- Compression ----------
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/plain application/javascript application/json image/svg+xml application/manifest+json application/xml
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript application/json image/svg+xml application/manifest+json application/xml
</IfModule>

# ---------- MIME types ----------
<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType font/woff2 .woff2
  AddType application/manifest+json .webmanifest
</IfModule>

# ---------- Browser caching ----------
# CSS/JS are not fingerprinted, so they get a shorter lifetime than images/fonts.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 week"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
  ExpiresByType image/webp "access plus 6 months"
  ExpiresByType image/jpeg "access plus 6 months"
  ExpiresByType image/png "access plus 6 months"
  ExpiresByType image/svg+xml "access plus 6 months"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# ---------- Security headers ----------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  # Enable once the site is served over HTTPS:
  # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  <FilesMatch "\.(woff2)$">
    Header set Access-Control-Allow-Origin "*"
  </FilesMatch>
</IfModule>
